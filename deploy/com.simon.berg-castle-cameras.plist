<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.simon.berg-castle-cameras</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/mediamtx</string>
        <string>/Users/jony/.openclaw/workspace/projects/berg-castle-panel/mediamtx.yml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jony/.openclaw/workspace/projects/berg-castle-panel</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/jony/.openclaw/workspace/projects/berg-castle-panel/logs/mediamtx.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jony/.openclaw/workspace/projects/berg-castle-panel/logs/mediamtx.err.log</string>
</dict>
</plist>
